includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - database/
    excludePaths:
        - database/migrations/*_create_permission_tables.php
    level: 10
    parseModelCastsMethod: true
    tmpDir: storage/framework/cache/phpstan